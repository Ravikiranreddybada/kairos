# Copy to .env. Every setting is documented in src/kairos/config.py.
KAIROS_ENV=dev
KAIROS_DATA_DIR=var

# fake = offline deterministic LLM (free, used by CI). anthropic = real Claude.
KAIROS_LLM_PROVIDER=fake
# KAIROS_ANTHROPIC_API_KEY=sk-ant-...
# KAIROS_LLM_STRONG_MODEL=claude-opus-5-5
# KAIROS_LLM_FAST_MODEL=claude-haiku-5-5

# JSON list of accepted API keys for the REST API
KAIROS_API_KEYS=["dev-key"]
# Separate keys for retrain + rollback (planner keys get 403 there)
KAIROS_ADMIN_API_KEYS=["dev-admin-key"]
# Wall-clock cap for one LLM-written SQL query
KAIROS_SQL_TIMEOUT_S=5
KAIROS_RATE_LIMIT_PER_MIN=120

# Optional: mirror registry runs to MLflow
# MLFLOW_TRACKING_URI=http://localhost:5000
